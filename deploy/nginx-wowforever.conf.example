# Beispiel-Konfiguration für die bestehende, direkt installierte nginx auf
# deinem Server. Kopiere diese Datei nach /etc/nginx/sites-available/wowforever,
# ersetze DEINE-ID.duckdns.org durch deine echte DuckDNS-Adresse und aktiviere
# sie (siehe README.md, Abschnitt 6).
#
# Dieser Block läuft absichtlich nur auf Port 80 (kein SSL) - certbot
# ergänzt beim Ausführen automatisch den HTTPS-Teil und die
# HTTP->HTTPS-Weiterleitung in dieser Datei.

server {
    listen 80;
    listen [::]:80;
    server_name DEINE-ID.duckdns.org;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
