# Werte findest du in Supabase unter: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key

# NUR serverseitig verwendet, NIE mit NEXT_PUBLIC_ prefixen und NIE
# in den Browser/an Nutzer ausliefern! Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Feste Admins (Notfall-Zugang): Discord-User-ID(s), kommagetrennt.
# Normalerweise sind automatisch alle Admin, die im Discord die Rolle
# "Offizier" oder "Gildenmeister" haben (meldet der Gilden-Bot).
ADMIN_DISCORD_IDS=123456789012345678,234567890123456789

# Optional: Datum im Format JJJJ-MM-TT. Wenn gesetzt, zeigt die
# Umfrageseite einen Hinweis "Bitte antworte bis zum ..." an.
# Weglassen = kein Hinweis.
NEXT_PUBLIC_SURVEY_DEADLINE=2026-10-05

# Optional: Datum im Format JJJJ-MM-TT. Wenn gesetzt, zeigt die
# Startseite einen Countdown "Noch X Tage bis WoW Forever!" an.
# Weglassen = kein Countdown.
NEXT_PUBLIC_LAUNCH_DATE=2026-10-12

# Optional: Discord "Incoming Webhook"-URL. Wenn gesetzt, postet die App
# bei jeder neuen/geänderten Antwort eine kurze Zusammenfassung in diesen
# Kanal. KEIN NEXT_PUBLIC-Prefix - bleibt serverseitig geheim, sonst
# könnte jede:r damit Nachrichten in euren Kanal posten.
# Erstellen: Discord -> Kanal -> Einstellungen -> Integrationen ->
# Webhooks -> Neuer Webhook -> URL kopieren. Weglassen = keine Benachrichtigung.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx
